  if(curSec.gabMode==="gabinete"&&!b.isGabinetePastoral) return false;
  return secAreas(curSec).indexOf(b.area||"secretaria")>=0;
}
function readBlockFields(b){
  (BLOCK_FIELDS[b.type]||[]).concat(["visibility"]).forEach(function(f){
    var el=document.getElementById("pb_"+f+"_"+b.id);
    if(!el) return;
    if(b.type==="image"&&f==="url"&&!el.value&&String(b.url||"").indexOf("data:")===0) return;
    b[f]=el.value;
  });
}
function layoutDraft(){
  ui.layoutDrafts=ui.layoutDrafts||{};
  var pg=ui.layoutPage||"home";
  if(!ui.layoutDrafts[pg]) ui.layoutDrafts[pg]=clone((L().pages||{})[pg]||defaultLayout(pg));
  return ui.layoutDrafts[pg];
}
function syncLayoutDraft(){
  if(!document.getElementById("ly_marker")||!ui.layoutDrafts) return;
  var list=ui.layoutDrafts[ui.layoutPage||"home"];if(!list) return;
  list.forEach(function(it){
    if(it.type!=="sys"){readBlockFields(it);return;}
    function g(f){return document.getElementById("ly_"+f+"_"+it.id);}
    var e=g("show");if(e) it.show=e.checked;
    ["title","subtitle","visibility"].forEach(function(f){var el=g(f);if(el) it[f]=el.value;});
    (SYS[it.key].opts||[]).forEach(function(o){
      if(o.type==="areas"){
        var boxes=document.querySelectorAll('input[data-lyarea="'+it.id+'"]');
        if(boxes.length){var arr=[];boxes.forEach(function(x){if(x.checked) arr.push(x.value);});it[o.f]=arr;}
        return;
      }
      var el=g(o.f);if(!el) return;
      it[o.f]=o.type==="check"?el.checked:el.value;
    });
  });
}
function syncAnyDraft(){syncPageDraft();syncLayoutDraft();}
function anyDraftBlock(id){
