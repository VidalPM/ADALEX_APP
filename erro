function copyText(txt,cb){
  if(navigator.clipboard&&window.isSecureContext){
    navigator.clipboard.writeText(txt).then(function(){cb&&cb(true);},function(){fallbackCopy(txt,cb);});
    return;
  }
  fallbackCopy(txt,cb);
}
function fallbackCopy(txt,cb){
  var ta=document.createElement("textarea");
  ta.value=txt;ta.style.position="fixed";ta.style.opacity="0";
  document.body.appendChild(ta);ta.focus();ta.select();
  var ok=false;
  try{ok=document.execCommand("copy");}catch(e){}
  ta.remove();
  cb&&cb(ok);
}
function driveId(url){
  var u=String(url||"");
  if(!/drive\.google\.com|docs\.google\.com|googleusercontent\.com\/d\//.test(u)) return "";
  var m=u.match(/(?:\/file\/d\/|\/d\/|[?&]id=)([\w-]{20,})/);
  return m?m[1]:"";
}
/* Links do Google Drive viram um endereço de imagem que abre em qualquer celular,
   sem precisar estar logado no Google (o arquivo precisa estar compartilhado como
   "Qualquer pessoa com o link"). */
function driveLink(url){
  var id=driveId(url);
  if(id) return "https://lh3.googleusercontent.com/d/"+id+"=w800";
  return url;
}
function imgSrc(u){return driveLink(u);}
/* se o endereço principal do Drive falhar, tenta o endereço alternativo */
window.addEventListener("error",function(e){
  var el=e.target;
  if(!el||el.tagName!=="IMG"||el.getAttribute("data-fb")) return;
  var id=driveId(el.src);
  if(id){el.setAttribute("data-fb","1");el.src="https://drive.google.com/thumbnail?id="+id+"&sz=w800";}
},true);
function fixDriveUrls(o){
  if(!o||typeof o!=="object") return;
  Object.keys(o).forEach(function(k){
    var val=o[k];
    if(typeof val==="string"){if(val.indexOf("data:")!==0&&driveId(val)&&/photo|logo|url|img|image/i.test(k)) o[k]=driveLink(val);}
    else if(val&&typeof val==="object") fixDriveUrls(val);
  });
}
/* ---------- compressão inteligente de imagens ----------
   Reduz o tamanho mantendo boa qualidade: redimensiona em etapas (mais nítido),
   escolhe automaticamente o formato mais leve (WebP/JPEG; PNG/WebP quando há
   transparência) e baixa a qualidade só até atingir o tamanho-alvo. */
var IMG_PROFILES={
  avatar:{max:480,square:true,target:45000},   /* fotos de pessoas e departamentos */
  logo:{max:512,square:false,target:60000},    /* logos (mantém fundo transparente) */
  banner:{max:1280,square:false,target:160000} /* imagens/banners das páginas */
};
var _webpOk=null;
function webpSupported(){
  return false; /* JPEG/PNG: compatível com todos os celulares, inclusive iPhones antigos */
  if(_webpOk===null){
    try{var c=document.createElement("canvas");c.width=c.height=2;_webpOk=c.toDataURL("image/webp").indexOf("data:image/webp")===0;}catch(e){_webpOk=false;}
  }
  return _webpOk;
}
function dataBytes(d){d=String(d||"");var i=d.indexOf(",");return i<0?d.length:Math.round((d.length-i-1)*3/4);}
function fmtKB(n){return n>=1048576?(n/1048576).toFixed(1).replace(".",",")+" MB":Math.max(1,Math.round(n/1024))+" KB";}
function drawScaled(img,sx,sy,sw,sh,w,h){
  var src=img,ox=sx,oy=sy,cw=sw,ch=sh,c,ctx;
  while(cw/2>=w&&ch/2>=h){
    c=document.createElement("canvas");c.width=Math.round(cw/2);c.height=Math.round(ch/2);
    ctx=c.getContext("2d");ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality="high";
    ctx.drawImage(src,ox,oy,cw,ch,0,0,c.width,c.height);
    src=c;ox=0;oy=0;cw=c.width;ch=c.height;
  }
  c=document.createElement("canvas");c.width=w;c.height=h;
  ctx=c.getContext("2d");ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality="high";
  ctx.drawImage(src,ox,oy,cw,ch,0,0,w,h);
  return c;
}
function canvasHasAlpha(cv){
  try{
    var d=cv.getContext("2d").getImageData(0,0,cv.width,cv.height).data;
    for(var i=3;i<d.length;i+=4){if(d[i]<250) return true;}
  }catch(e){}
  return false;
}
function flattenWhite(cv){
  var c=document.createElement("canvas");c.width=cv.width;c.height=cv.height;
  var ctx=c.getContext("2d");ctx.fillStyle="#ffffff";ctx.fillRect(0,0,c.width,c.height);ctx.drawImage(cv,0,0);
  return c;
}
function encodeBest(cv,alpha,q){
  var outs=[];
  if(webpSupported()) outs.push(cv.toDataURL("image/webp",q));
  if(alpha){if(!outs.length) outs.push(cv.toDataURL("image/png"));}
  else outs.push(flattenWhite(cv).toDataURL("image/jpeg",q));
  return outs.sort(function(a,b){return a.length-b.length;})[0];
}
function compressImageEl(img,profile){
  var P=IMG_PROFILES[profile]||IMG_PROFILES.avatar;
  var iw=img.naturalWidth||img.width,ih=img.naturalHeight||img.height;
  if(!iw||!ih) return null;
  var sx=0,sy=0,sw=iw,sh=ih;
  if(P.square){var side=Math.min(iw,ih);sx=(iw-side)/2;sy=(ih-side)/2;sw=sh=side;}
  var max=P.max,best=null,qs=[0.86,0.8,0.74,0.68,0.62];
  for(var attempt=0;attempt<5;attempt++){
    var scale=Math.min(1,max/Math.max(sw,sh));
    var w=Math.max(1,Math.round(sw*scale)),h=Math.max(1,Math.round(sh*scale));
    var cv=drawScaled(img,sx,sy,sw,sh,w,h);
    var alpha=canvasHasAlpha(cv);
    for(var i=0;i<qs.length;i++){
      var out=encodeBest(cv,alpha,qs[i]);
      if(!best||out.length<best.length) best=out;
      if(dataBytes(out)<=P.target) return out;
      if(alpha&&!webpSupported()) break;
    }
    max=Math.round(max*0.82);
    if(max<200) break;
  }
  return best;
}
function compressFile(file,profile,cb){
  var r=new FileReader();
  r.onload=function(){
    var img=new Image();
    img.onload=function(){
      var out=null;
      try{out=compressImageEl(img,profile);}catch(e){}
      if(!out){toast("Não foi possível processar esta imagem.","error");return;}
      cb(out,dataBytes(r.result),dataBytes(out));
    };
    img.onerror=function(){toast("Formato de imagem não suportado. Use JPG, PNG ou WebP.","error");};
    img.src=r.result;
  };
  r.readAsDataURL(file);
}
function compressDataUrl(src,profile,cb){
  var img=new Image();
  img.onload=function(){
    var out=null;
    try{out=compressImageEl(img,profile);}catch(e){}
    cb(out&&out.length<src.length?out:src);
  };
  img.onerror=function(){cb(src);};
  img.src=src;
}
function resizePhoto(file,cb){compressFile(file,"avatar",cb);}
function pickFile(cb,profile){
  var inp=document.createElement("input");inp.type="file";inp.accept="image/*";
  inp.onchange=function(){
    if(!inp.files[0]) return;
    compressFile(inp.files[0],profile||"avatar",function(data,before,after){
      cb(data);
      setTimeout(function(){toast("Imagem otimizada: "+fmtKB(before)+" → "+fmtKB(after),"success");},900);
    });
  };
  inp.click();
}

/* ---------- permissions ---------- */
function can(key,roleId){
  var explicit=!!roleId;
  roleId=roleId||session.role;
  var ro=roleObj(roleId);
  if(roleId==="admin_geral"||ro.level>=4) return true;
  if(!explicit){var ov=userPermOverride(key);if(ov!==null) return ov;}
  var v=state.permissions[key]&&state.permissions[key][roleId];
  if(typeof v==="boolean") return v;
  var all=PERM_VIEW.concat(PERM_MANAGE).filter(function(x){return x.k===key;})[0];
  var baseIdx=Math.min(Math.max(ro.level||0,0),4);
  return all?!!all.def[baseIdx]:false;
}
function visible(vis,roleId,dep){
  roleId=roleId||session.role;
  var ro=roleObj(roleId);
  if(roleId==="admin_geral"||ro.level>=4) return true;
  if(vis==="personalizado") return !!(dep&&dep.visibleTo&&dep.visibleTo.indexOf(roleId)>=0);
  if(vis==="visitantes") return roleId==="visitante";
  var min=VIS_MIN[vis];
  if(min===undefined) return true;
  return (ro.level||0)>=min;
}
function canAdmin(){
  return session.role==="admin_geral"||roleLevel(session.role)>=4||can("verDiretoriaAdmin")||can("gerenciarPix")||can("gerenciarIdentidade")||can("gerenciarUsuarios")||can("gerenciarCultos")||can("gerenciarAvisosLinks")||can("gerenciarPaginas");
}
