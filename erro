var PROTECTED_ROLES={visitante:1,membro:1,admin_geral:1};
function pkey(n){return plain(n).replace(/\s+/g," ");}
/* nomes cadastrados na Diretoria e nas Equipes dos departamentos */
function teamDirectoryNames(st){
  st=st||state;
  var names={};
  (st.directorate||[]).forEach(function(d){if(d.name) names[pkey(d.name)]=1;});
  (st.departments||[]).forEach(function(dep){(dep.team||[]).forEach(function(m){if(m.name) names[pkey(m.name)]=1;});});
  return names;
}
/* quem não está na Diretoria/Equipes vira Membro, sem função (administrador não é alterado) */
function membersCleanup(st,apply){
  st=st||state;
  var names=teamDirectoryNames(st),res={roles:0,funcs:0,depts:0,total:0,kept:0};
  (st.users||[]).forEach(function(u){
    var lvl=((st.roles||DEFAULT_ROLES).find(function(r){return r.id===u.role;})||{}).level||0;
    if(u.role==="admin_geral"||lvl>=4) return;
    if(names[pkey(u.name)]){res.kept++;return;}
    var ch=false;
    if(u.role!=="membro"){res.roles++;ch=true;if(apply) u.role="membro";}
    if(Array.isArray(u.functions)&&u.functions.length){res.funcs++;ch=true;if(apply) u.functions=[];}
    else if(u.functions&&!Array.isArray(u.functions)){res.funcs++;ch=true;if(apply) u.functions=[];}
    if(u.department){res.depts++;ch=true;if(apply) u.department="";}
    if(ch) res.total++;
  });
  return res;
}
