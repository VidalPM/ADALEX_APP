/* ======================================================================
   AVISO DE NOVA ATUALIZAÇÃO
   - Ao abrir o app (e ao voltar para ele), confere no site se existe uma
     versão publicada mais nova que a aberta neste aparelho.
   - Se existir: popup com as novidades + botão "Atualizar agora".
   - Se o app já abriu na versão nova: popup "App atualizado" (uma vez).
   ====================================================================== */
/* A versão = "impressão digital" do código do app + data de publicação dos dados.
   Assim qualquer mudança (no código ou nos dados publicados) é reconhecida. */
var APP_VERSION="3.1.2";
var IS_GAS=!!(window.google&&google.script&&google.script.run);
var GAS=(typeof GAS_CONFIG!=="undefined"&&GAS_CONFIG)||{};
var MAIN_SCRIPT_TEXT=(document.currentScript&&document.currentScript.textContent)||"";
function codeFingerprint(scriptText){
  var t=String(scriptText||"").replace(/\r/g,"").replace(/\/\*__CUSTOM_STATE_START__\*\/[\s\S]*?\/\*__CUSTOM_STATE_END__\*\//,"");
  var h=0x811c9dc5;
  for(var i=0;i<t.length;i++){h^=t.charCodeAt(i);h=Math.imul(h,0x01000193);}
  return (h>>>0).toString(16)+"-"+t.length.toString(36);
}
var LOADED_PUBLISHED=String((EMBEDDED_STATE&&EMBEDDED_STATE.publishedAt)||baseDefaultState().publishedAt||"");
var LOADED_VERSION=IS_GAS?(APP_VERSION+"|"+LOADED_PUBLISHED):((MAIN_SCRIPT_TEXT?codeFingerprint(MAIN_SCRIPT_TEXT):"x")+"|"+LOADED_PUBLISHED);
var SEEN_KEY="adalex_seen_version";
var upd={checking:false,lastCheck:0,shownFor:""};
function updInfo(src){
  var u=(src&&src.updateInfo)||{};
  return {
    enabled:u.enabled!==false,
    title:u.title||"Nova atualização disponível!",
    notes:u.notes||"",
    force:!!u.force
  };
}
function fmtVersion(v){
  var n=+String(v||"").split("|").pop();if(!n) return "";
  try{return new Date(n).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",year:"numeric",hour:"2-digit",minute:"2-digit"});}catch(e){return "";}
}
function parseRemoteVersion(html){
  var m=html.match(/var EMBEDDED_STATE=([\s\S]*?);\/\*__CUSTOM_STATE_END__\*\//);
  var st=null;
  if(m&&m[1]&&m[1].trim()!=="null"){try{st=JSON.parse(m[1]);}catch(e){st=null;}}
  var pub=st&&st.publishedAt?String(st.publishedAt):"";
  if(!pub){var b=html.match(/publishedAt:(\d{10,})/);pub=b?b[1]:"";}
  var code="x",blocks=html.match(/\x3Cscript>[\s\S]*?\x3C\/script>/g)||[];
  for(var i=0;i<blocks.length;i++){
    if(blocks[i].indexOf("__CUSTOM_STATE_START__")>=0){code=codeFingerprint(blocks[i].slice(8,-9));break;}
  }
  return {version:(pub?code+"|"+pub:""),info:updInfo(st)};
}
function checkForUpdate(force){
  if(IS_GAS){gasCheckUpdate(force);return;}
  if(upd.checking) return;
  if(!/^https?:$/.test(location.protocol)) return;
  if(!force&&Date.now()-upd.lastCheck<60000) return;
  if(navigator.onLine===false) return;
  upd.checking=true;upd.lastCheck=Date.now();
  var url=location.href.split("#")[0].split("?")[0];
  fetch(url,{cache:"no-store",headers:{"Accept":"text/html"}})
    .then(function(r){return r.ok?r.text():"";})
    .then(function(html){
      upd.checking=false;
      if(!html||html.indexOf("__CUSTOM_STATE_START__")<0) return;
      var rv=parseRemoteVersion(html);
      if(!rv.version||rv.version===LOADED_VERSION) return;
      if(!rv.info.enabled) return;
      if(upd.shownFor===rv.version) return;
      try{if(sessionStorage.getItem("adalex_upd_later")===rv.version&&!rv.info.force) return;}catch(e){}
      upd.shownFor=rv.version;
      showUpdatePopup(rv.info,rv.version,false);
    })
    .catch(function(){upd.checking=false;});
}
function updatePopupHtml(info,version,alreadyUpdated){
  var t=theme();
  var notes=info.notes?'<div style="background:#f5f5f4;border-radius:14px;padding:.8rem .9rem;font-size:.84rem;line-height:1.55;max-height:40vh;overflow:auto"><div style="font-weight:800;font-size:.78rem;color:#78716c;margin-bottom:.3rem">NOVIDADES</div>'+richText(info.notes)+"</div>":"";
  var vtxt=fmtVersion(version);
  return '<div style="padding:1.35rem 1.25rem 1.25rem;display:grid;gap:.85rem;text-align:center">'+
    '<div style="width:68px;height:68px;margin:0 auto;border-radius:20px;background:linear-gradient(135deg,'+t.hex+","+t.hex2+');display:flex;align-items:center;justify-content:center;font-size:2rem;box-shadow:0 10px 24px rgba(0,0,0,.18)">'+(alreadyUpdated?"✅":"🚀")+"</div>"+
    '<div><div style="font-weight:900;font-size:1.15rem;line-height:1.25">'+esc(alreadyUpdated?"App atualizado!":info.title)+"</div>"+
      '<p class="help" style="margin:.3rem 0 0">'+(alreadyUpdated?"Você já está usando a versão mais recente do aplicativo.":"Uma nova versão do aplicativo da igreja foi publicada. Atualize para ver as novidades.")+(vtxt?"<br><span style=\"font-size:.72rem\">Versão de "+esc(vtxt)+"</span>":"")+"</p></div>"+
    '<div style="text-align:left">'+notes+"</div>"+
    (alreadyUpdated
      ?'<button class="btn-main" style="width:100%;background:linear-gradient(90deg,'+t.hex+","+t.hex2+')" data-close>Continuar</button>'
      :'<button class="btn-main" id="updNow" style="width:100%;min-height:52px;font-size:.95rem;background:linear-gradient(90deg,'+t.hex+","+t.hex2+')">🔄 Atualizar agora</button>'+
        (info.force?"":'<button class="btn-soft" style="width:100%" id="updLater">Depois</button>'))+
  "</div>";
}
function showUpdatePopup(info,version,alreadyUpdated){
  document.querySelectorAll("dialog.adalex.upd-dialog").forEach(function(d){d.close();});
  var d=openDialog(updatePopupHtml(info,version,alreadyUpdated),function(d){
    d.classList.add("upd-dialog");
    var later=d.querySelector("#updLater");
    if(later) later.addEventListener("click",function(){
      try{sessionStorage.setItem("adalex_upd_later",version);}catch(e){}
      d.close();
    });
    var now=d.querySelector("#updNow");
    if(now) now.addEventListener("click",function(){
      now.disabled=true;now.textContent="Atualizando...";
      try{localStorage.setItem(SEEN_KEY,version);}catch(e){}
      applyUpdateNow();
    });
    if(info.force&&!alreadyUpdated){
      var x=d.querySelector(".dialog-close-btn");if(x) x.remove();
      d.addEventListener("cancel",function(e){e.preventDefault();});
      d.addEventListener("click",function(e){if(e.target===d) e.stopImmediatePropagation();},true);
    }
  });
  return d;
}
function applyUpdateNow(){
  if(IS_GAS&&gasUrl()){
    try{window.top.location.href=gasUrl();}catch(e){window.open(gasUrl(),"_top");}
    return;
  }
  var done=false;
  function go(){if(done) return;done=true;location.reload();}
  var jobs=[];
  try{
    if(window.caches&&caches.keys) jobs.push(caches.keys().then(function(keys){return Promise.all(keys.filter(function(k){return k.indexOf("adalex")===0;}).map(function(k){return caches.delete(k);}));}));
  }catch(e){}
  try{
    if(navigator.serviceWorker&&navigator.serviceWorker.getRegistration) jobs.push(navigator.serviceWorker.getRegistration().then(function(r){if(r) return r.update();}).catch(function(){}));
  }catch(e){}
  Promise.all(jobs).then(go,go);
  setTimeout(go,2500);
}
/* já abriu na versão nova? mostra as novidades uma vez */
function showWhatsNewIfUpdated(){
  var seen="";
  try{seen=localStorage.getItem(SEEN_KEY)||"";}catch(e){}
  try{localStorage.setItem(SEEN_KEY,LOADED_VERSION);}catch(e){}
  if(!seen||seen===LOADED_VERSION) return;
  var info=updInfo(EMBEDDED_STATE);
  if(!info.enabled) return;
  showUpdatePopup(info,LOADED_VERSION,true);
}
function initUpdateChecker(){
  setTimeout(function(){showWhatsNewIfUpdated();checkForUpdate(true);},1500);
  document.addEventListener("visibilitychange",function(){if(document.visibilityState==="visible") checkForUpdate(false);});
  window.addEventListener("online",function(){checkForUpdate(true);});
  setInterval(function(){checkForUpdate(false);},30*60*1000);
}
