function renderLayoutPage(pg){
  var t=theme();
  var items=(L().pages||{})[pg]||defaultLayout(pg);
  var parts=[],group="";
  function flush(){if(group){parts.push({k:"custom",h:'<div class="card"><div class="cp-blocks">'+group+"</div></div>"});group="";}}
  items.forEach(function(it){
    if(it.type==="sys"){
      flush();
      if(!SYS[it.key]||it.show===false||!visible(it.visibility||"todos",session.role)) return;
      curSec=it;
      var h="";
      try{h=renderSys(it,pg);}finally{curSec=null;}
      if(h) parts.push({k:it.key,h:h});
    }else{
      var bh=blockHtml(it,t);
      if(bh) group+=bh;
    }
  });
  flush();
  var out="";
  for(var i=0;i<parts.length;i++){
    var a=parts[i],b=parts[i+1];
    if(b&&((a.k==="notices"&&b.k==="links")||(a.k==="links"&&b.k==="notices"))){out+='<div class="safe-grid-2">'+a.h+b.h+"</div>";i++;}
    else out+=a.h;
  }
  return '<section style="max-width:56rem;margin:-1.35rem auto 0;padding:0 .85rem;width:100%;display:flex;flex-direction:column;gap:.9rem">'+(out||'<div class="card"><p class="help" style="margin:0">Nenhum conteúdo disponível nesta página para o seu acesso.</p></div>')+"</section>";
}

