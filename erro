function singleLoginSubmit(raw){
  var val=String(raw||"").trim();
  var letters=/[A-Za-zÀ-ÿ]/.test(val),digits=val.replace(/\D/g,"");
  if(!val) return failLogin("Digite seu CPF (membro) ou seu nome completo (visitante).");
  /* senha master ou senha pessoal digitada no campo principal: entra como equipe/administrador */
  var tries=letters?[val]:[val,digits];
  for(var ti=0;ti<tries.length;ti++){var tv=tries[ti];if(tv&&(passMatches(state.church.masterAdminPin,tv)||state.users.some(function(u){return u.accessPassword&&passMatches(u.accessPassword,tv);}))) return loginStaff(tv);}
  if(letters) return enterVisitor(val);
  if(digits.length>=9) return loginByCpf(digits);
  return failLogin("CPF incompleto. Digite os 11 números do seu CPF.");
}
function enterVisitor(raw){
  var nm=String(raw||"").trim().replace(/\s+/g," ");
  if(nm.split(" ").length<2||nm.length<5) return failLogin("Visitante: informe seu nome completo (nome e sobrenome).");
  closeLoginDialog();
  ui.forceGate=false;
  session={role:"visitante",userId:null,realRole:"visitante",visitorName:nm,identified:true,authBy:"visitor"};
  saveSession();
  ui.loginError="";
  toast("Paz do Senhor, "+nm.split(" ")[0]+"!","success");
  render();
  maybeShowInstallPopup();
  return true;
}
function loginStaff(raw){
  var pass=normalizePass(raw);
  if(!pass) return failLogin("Digite sua senha pessoal.");
  if(passMatches(state.church.masterAdminPin,pass)){
    var adm=findUser("u1")||{id:"u1",name:"Administrador",role:"admin_geral",photo:"",memberCode:""};
    return previewLogin(adm,"admin_geral",true,"password");
  }
  var usr=state.users.find(function(u){return passMatches(u.accessPassword,pass);});
  if(!usr) return failLogin("Senha pessoal não encontrada. Confira ou peça ao administrador para cadastrar sua senha.");
  return previewLogin(usr,usr.role,roleLevel(usr.role)>=4,"password");
}

