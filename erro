  var H=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];
  var l=s.length,nBlocks=((l+8)>>6)+1,W=new Array(nBlocks*16),i,j;
  for(i=0;i<W.length;i++) W[i]=0;
  for(i=0;i<l;i++) W[i>>2]|=(s.charCodeAt(i)&0xff)<<(24-(i%4)*8);
  W[l>>2]|=0x80<<(24-(l%4)*8);
  W[nBlocks*16-1]=l*8;
  var w=new Array(64);
  for(i=0;i<nBlocks;i++){
    for(j=0;j<16;j++) w[j]=W[i*16+j];
    for(j=16;j<64;j++){
      var x=w[j-15],y=w[j-2];
      var s0=((x>>>7)|(x<<25))^((x>>>18)|(x<<14))^(x>>>3);
      var s1=((y>>>17)|(y<<15))^((y>>>19)|(y<<13))^(y>>>10);
      w[j]=(w[j-16]+s0+w[j-7]+s1)|0;
    }
    var a=H[0],b=H[1],c=H[2],d=H[3],e=H[4],f=H[5],g=H[6],h=H[7];
    for(j=0;j<64;j++){
      var S1=((e>>>6)|(e<<26))^((e>>>11)|(e<<21))^((e>>>25)|(e<<7));
      var t1=(h+S1+((e&f)^(~e&g))+K[j]+w[j])|0;
      var S0=((a>>>2)|(a<<30))^((a>>>13)|(a<<19))^((a>>>22)|(a<<10));
      var t2=(S0+((a&b)^(a&c)^(b&c)))|0;
      h=g;g=f;f=e;e=(d+t1)|0;d=c;c=b;b=a;a=(t1+t2)|0;
    }
    H[0]=(H[0]+a)|0;H[1]=(H[1]+b)|0;H[2]=(H[2]+c)|0;H[3]=(H[3]+d)|0;
    H[4]=(H[4]+e)|0;H[5]=(H[5]+f)|0;H[6]=(H[6]+g)|0;H[7]=(H[7]+h)|0;
  }
  var out="";
  for(i=0;i<8;i++) out+=("00000000"+(H[i]>>>0).toString(16)).slice(-8);
  return out;
}
var HASH_SALT="adalex-ad-alexandra-v1";
var HASH_ROUNDS=3000;
var _hashCache={};
function secretHash(val){
  var key=String(val);
  if(_hashCache[key]) return _hashCache[key];
  var h=sha256hex(HASH_SALT+"|"+key);
  for(var i=0;i<HASH_ROUNDS;i++) h=sha256hex(h+HASH_SALT);
  return (_hashCache[key]="h1:"+h);
}
function isHashed(v){return /^h1:[0-9a-f]{64}$/.test(String(v||""));}
function normCpf(v){return String(v||"").replace(/\D/g,"").replace(/^0+/,"");}
function cpfHash(v){return secretHash("cpf:"+normCpf(v));}
function passHash(p){return secretHash("pw:"+normalizePass(p));}
function cpfMatches(stored,digits){
  if(!stored||!normCpf(digits)) return false;
  return isHashed(stored)?stored===cpfHash(digits):cpfEq(stored,digits);
}
function passMatches(stored,pass){
  if(!stored||!normalizePass(pass)) return false;
  return isHashed(stored)?stored===passHash(pass):normalizePass(stored)===normalizePass(pass);
}
/* cópia dos dados preparada para publicação (sem dados sensíveis legíveis) */
function publishableState(){
  var st=clone(state);
  var pub=st.church.publishOptions||{};
  st.users.forEach(function(u){
    if(u.cpf&&!isHashed(u.cpf)) u.cpf=cpfHash(u.cpf);
    if(u.accessPassword&&!isHashed(u.accessPassword)) u.accessPassword=passHash(u.accessPassword);
    if(!pub.contacts){u.whatsapp="";u.email="";}
    if(pub.photos===false) u.photo="";
  });
  var c=st.church;
  if(c.masterAdminPin&&!isHashed(c.masterAdminPin)) c.masterAdminPin=passHash(c.masterAdminPin);
  ["secretariaPin","tesourariaPin","ebdPin"].forEach(function(k){if(k in c) c[k]="";});
  st.submissions=[];
  return st;
}
/* HTML limpo para publicar: remove o que o navegador/extensões colocaram na página */
function cleanCloneForExport(){
  var clone=document.documentElement.cloneNode(true);
  clone.removeAttribute("style");
  var head=clone.querySelector("head"),body=clone.querySelector("body");
  if(head){
    Array.prototype.slice.call(head.children).forEach(function(el){
      var tag=el.tagName.toLowerCase();
      var ok=false;
      if(tag==="meta"||tag==="title") ok=true;
      else if(tag==="style") ok=!el.attributes.length;
      else if(tag==="link"){
        var rel=(el.getAttribute("rel")||"").toLowerCase(),href=el.getAttribute("href")||"";
        ok=(el.id==="pwaManifest"||el.id==="appleTouchIcon"||(rel==="preconnect"&&/fonts\.googleapis/.test(href))||(rel==="stylesheet"&&/fonts\.googleapis/.test(href)));
      }
      if(!ok) el.remove();
    });
    ["#pwaManifest","#appleTouchIcon"].forEach(function(sel){var l=head.querySelector(sel);if(l) l.removeAttribute("href");});
  }
  if(body){
    body.removeAttribute("style");
    var keepIds={buildBanner:1,toastContainer:1,topNav:1,appRoot:1,adxFoot:1,"adalex-sw-code":1};
    Array.prototype.slice.call(body.children).forEach(function(el){
      var tag=el.tagName.toLowerCase();
      if(keepIds[el.id]) return;
      if(tag==="script"&&!el.getAttribute("src")&&!el.id&&el.textContent.indexOf("__CUSTOM_STATE_START__")>=0) return;
      el.remove();
    });
    ["#buildBanner"].forEach(function(sel){var e=body.querySelector(sel);if(e) e.removeAttribute("style");});
    ["#navLeft","#navRight","#simBar","#appRoot","#footName","#footInfo"].forEach(function(sel){var e=body.querySelector(sel);if(e) e.innerHTML="";});
    var tc=body.querySelector("#toastContainer");if(tc){tc.innerHTML="";tc.classList.remove("show");}
  }
  return "<!DOCTYPE html>\n"+clone.outerHTML;
}
function downloadHtml(htmlStr){
  var blob=new Blob([htmlStr],{type:"text/html;charset=utf-8"});
  var a=document.createElement("a");
  a.href=URL.createObjectURL(blob);
  a.download="index.html";
  document.body.appendChild(a);
  a.click();
  setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},500);
}

