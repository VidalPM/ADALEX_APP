function safeUrl(u){u=String(u||"").trim();if(/^\s*(javascript|vbscript):/i.test(u)) return "#";if(/^\s*data:/i.test(u)&&!/^data:image\//i.test(u)) return "#";return u;}
function blockHref(b){
  var val=String(b.value||"").trim();
  if(b.action==="whatsapp"){
    if(/^https?:\/\//i.test(val)) return safeUrl(val);
    var n=val.replace(/\D/g,"");
    if(n&&n.length<=11) n="55"+n;
    return "https://wa.me/"+n+(b.message?"?text="+encodeURIComponent(b.message):"");
  }
  if(b.action==="email") return "mailto:"+val+(b.message?"?subject="+encodeURIComponent(b.message):"");
  if(b.action==="phone") return "tel:"+val.replace(/[^\d+]/g,"");
  return safeUrl(val);
}
