<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" id="metaThemeColor" content="#1e40af">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="ADALEX Digital">
<meta name="mobile-web-app-capable" content="yes">
<link id="pwaManifest" rel="manifest">
<link id="appleTouchIcon" rel="apple-touch-icon">
<title>ADALEX DIGITAL • CONECTANDO A IGREJA Versão 1.0 v1</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap">
<style>
:root {
  color-scheme: light;
  --accent: #1e40af;
  --accent-contrast: #ffffff;
  --bg: #f5f5f4;
  --surface: #ffffff;
  --text: #1c1917;
  --text-muted: #57534e;
  --border: rgba(20, 23, 31, 0.12);
  --radius: 14px;
  --shadow: 0 2px 8px rgba(20, 23, 31, 0.06);
  --space: 16px;
  --success: #0a7a35;
  --danger: #be123c;
  --warning: #8a5300;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
}

*, *::before, *::after, ::backdrop {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0 solid;
}

[hidden]:where(:not([hidden="until-found"])) { display: none !important; }
.hidden { display: none !important; }
h1, h2, h3, h4, h5, h6 { font-size: inherit; font-weight: inherit; }
a { color: inherit; text-decoration: inherit; }
b, strong { font-weight: 700; }
ol, ul, menu { list-style: none; }
svg, video, canvas, iframe { display: block; vertical-align: middle; }
button, input, select, textarea { font: inherit; color: inherit; background-color: transparent; border-radius: 0; }
button, a { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
table { border-collapse: collapse; }
img { max-width: 100%; display: block; }

html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  overflow-x: hidden;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  -webkit-font-smoothing: antialiased;
}

::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-thumb { background: #d6d3d1; border-radius: 6px; }

@keyframes fadeInScale {
  from { opacity: 0; transform: scale(.97); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(28px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-modal { animation: fadeInScale .2s ease-out both; }

/* Top build & status banner */
.build-banner {
  background: #f59e0b;
  color: #1c1917;
  font-size: .68rem;
  font-weight: 800;
  text-align: center;
  padding: calc(.28rem + var(--safe-top)) .5rem .28rem;
  letter-spacing: .04em;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
}
.offline-chip {
  background: #1c1917;
  color: #fde68a;
  padding: .1rem .45rem;
  border-radius: 999px;
  font-size: .62rem;
}

/* Sticky mobile-first navigation */
nav.top-nav {
  background: #0c0a09;
  position: sticky;
  top: 0;
  z-index: 30;
  box-shadow: 0 2px 10px rgba(0, 0, 0, .22);
}
.nav-inner {
  max-width: 56rem;
  margin: 0 auto;
  padding: .5rem .75rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .45rem;
}
.nav-scroll {
  display: flex;
  align-items: center;
  gap: .35rem;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  flex: 1;
  min-width: 0;
}
.nav-scroll::-webkit-scrollbar { display: none; }

.nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .35rem;
  min-height: 38px;
  padding: .42rem .75rem;
  border-radius: 12px;
  font-size: .75rem;
  font-weight: 700;
  color: #e7e5e4;
  white-space: nowrap;
  cursor: pointer;
  flex-shrink: 0;
  transition: transform .12s ease, background-color .15s ease;
}
.nav-btn:active { transform: scale(.97); }
.nav-btn.on { background: #fff; color: #0c0a09; }
.nav-btn.gold { background: #f59e0b; color: #0c0a09; }
.nav-btn.install { background: #16a34a; color: #fff; }

.profile-btn {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  min-height: 38px;
  background: #1c1917;
  border: 1px solid #44403c;
  border-radius: 12px;
  padding: .35rem .6rem;
  color: #fff;
  font-weight: 700;
  font-size: .75rem;
  cursor: pointer;
  flex-shrink: 0;
}
.profile-btn:active { transform: scale(.97); }

/* Simulator bar */
.sim-bar {
  background: #451a03;
  color: #fef3c7;
  font-size: .7rem;
  padding: .4rem .75rem;
  display: flex;
  align-items: center;
  gap: .35rem;
  overflow-x: auto;
  scrollbar-width: none;
  white-space: nowrap;
}
.sim-bar::-webkit-scrollbar { display: none; }

/* Dialog / Bottom sheet */
dialog.adalex {
  position: fixed;
  inset: 0;
  width: 100%;
  max-width: 100%;
  height: 100%;
  max-height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 40;
}
dialog.adalex::backdrop {
  background: rgba(12, 10, 9, .75);
  backdrop-filter: blur(5px);
}
@media (min-width: 640px) {
  dialog.adalex { align-items: center; padding: 1rem; }
}
.adalex-panel {
  background: #fff;
  width: 100%;
  max-width: 34rem;
  max-height: 90dvh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
  border-radius: 24px 24px 0 0;
  padding-bottom: calc(.5rem + var(--safe-bottom));
  animation: slideUp .25s ease-out both;
  position: relative;
  box-shadow: 0 -8px 30px rgba(0, 0, 0, .22);
}
.sheet-handle {
  width: 38px;
  height: 4px;
  background: #d6d3d1;
  border-radius: 999px;
  margin: .55rem auto .15rem;
}
@media (min-width: 640px) {
  .adalex-panel { border-radius: 24px; padding-bottom: 0; }
  .sheet-handle { display: none; }
}
.dialog-close-btn {
  position: absolute;
  top: .65rem;
  right: .65rem;
  z-index: 3;
  background: rgba(245, 245, 244, .95);
  color: #1c1917;
  border: 1px solid #e7e5e4;
  border-radius: 999px;
  width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
}
.dialog-close-btn:active { transform: scale(.94); }

/* Toast */
.toast-container {
  position: fixed;
  top: calc(.75rem + var(--safe-top));
  left: 50%;
  transform: translateX(-50%);
  z-index: 60;
  width: 92%;
  max-width: 28rem;
  pointer-events: none;
  display: none;
}
.toast-container.show { display: block; }
.toast-item {
  background: #1c1917;
  color: #fff;
  padding: .75rem 1rem;
  border-radius: 14px;
  font-size: .82rem;
  font-weight: 600;
  margin-bottom: .5rem;
  box-shadow: 0 8px 24px rgba(0, 0, 0, .24);
  text-align: center;
  animation: slideUp .18s ease-out both;
}

/* Cards & Buttons */
.card {
  background: #fff;
  border-radius: 20px;
  box-shadow: var(--shadow);
  border: 1px solid rgba(231, 229, 228, .75);
  padding: 1rem;
}
@media (min-width: 640px) {
  .card { border-radius: 24px; padding: 1.2rem; }
}

.btn-main, .btn-soft, .btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .4rem;
  min-height: 42px;
  border-radius: 12px;
  cursor: pointer;
  text-align: center;
  line-height: 1.2;
  transition: transform .12s ease, opacity .15s ease;
}
.btn-main:active, .btn-soft:active, .btn-danger:active { transform: scale(.98); }

.btn-main {
  background: linear-gradient(90deg, #1e40af, #3730a3);
  color: #fff;
  font-weight: 800;
  padding: .65rem 1rem;
  font-size: .84rem;
}
.btn-soft {
  background: #f5f5f4;
  color: #1c1917;
  border: 1px solid #e7e5e4;
  font-weight: 700;
  padding: .55rem .85rem;
  font-size: .78rem;
}
.btn-danger {
  background: #fff1f2;
  color: #9f1239;
  border: 1px solid #fecdd3;
  font-weight: 700;
  padding: .55rem .85rem;
  font-size: .78rem;
}
.btn-sm {
  min-height: 36px;
  padding: .4rem .65rem;
  font-size: .74rem;
}

/* Inputs: 16px prevents automatic zoom on mobile Safari/Chrome */
.fld {
  width: 100%;
  min-height: 44px;
  border: 1px solid #d6d3d1;
  border-radius: 12px;
  padding: .6rem .75rem;
  font-size: 16px;
  background: #fff;
  color: #1c1917;
}
input[type="color"].fld {
  padding: .25rem;
  cursor: pointer;
}
textarea.fld { min-height: 84px; resize: vertical; }
.fld:focus {
  outline: none;
  border-color: #1e40af;
  box-shadow: 0 0 0 3px rgba(30, 64, 175, .15);
}
input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: #1e40af;
  vertical-align: middle;
}

.lbl {
  font-size: .76rem;
  font-weight: 700;
  color: #44403c;
  display: block;
  margin-bottom: .3rem;
}
.help {
  font-size: .74rem;
  color: #78716c;
  margin-top: .25rem;
  line-height: 1.4;
}
.pill {
  display: inline-flex;
  align-items: center;
  gap: .25rem;
  font-size: .66rem;
  font-weight: 700;
  padding: .18rem .55rem;
  border-radius: 999px;
  border: 1px solid;
  white-space: nowrap;
}

/* Role & Status badge colors */
.b-sky { background: #e0f2fe; color: #0c4a6e; border-color: #7dd3fc; }
.b-emerald { background: #d1fae5; color: #064e3b; border-color: #6ee7b7; }
.b-purple { background: #f3e8ff; color: #581c87; border-color: #d8b4fe; }
.b-amber { background: #fef3c7; color: #78350f; border-color: #fcd34d; }
.b-rose { background: #ffe4e6; color: #881337; border-color: #fda4af; }
.b-stone { background: #f5f5f4; color: #292524; border-color: #d6d3d1; }
.b-indigo { background: #e0e7ff; color: #1e1b4b; border-color: #a5b4fc; }
.b-teal { background: #ccfbf1; color: #134e4a; border-color: #5eead4; }
.b-white { background: #ffffff; color: #44403c; border-color: #d6d3d1; }

/* Selectable function chips */
.func-chip {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  min-height: 36px;
  padding: .35rem .7rem;
  border-radius: 999px;
  font-size: .75rem;
  font-weight: 700;
  border: 1px solid #d6d3d1;
  background: #fafaf9;
  color: #44403c;
  cursor: pointer;
  transition: all .12s ease;
}
.func-chip.on {
  background: #1e40af;
  color: #fff;
  border-color: #1e40af;
}

/* Collapsible sections in Admin */
details.adx-acc {
  background: #fff;
  border-radius: 20px;
  box-shadow: var(--shadow);
  border: 1px solid rgba(231, 229, 228, .85);
  margin-bottom: .85rem;
  overflow: hidden;
}
details.adx-acc > summary {
  list-style: none;
  cursor: pointer;
  padding: .95rem 1rem;
  font-weight: 800;
  font-size: .9rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .5rem;
  background: #fafaf9;
}
details.adx-acc > summary::-webkit-details-marker { display: none; }
details.adx-acc > summary::after {
  content: "▾";
  font-size: 1rem;
  color: #57534e;
  transition: transform .15s ease;
}
details.adx-acc[open] > summary::after { transform: rotate(180deg); }
details.adx-acc > .acc-body {
  padding: 1rem;
  border-top: 1px solid #e7e5e4;
  display: grid;
  gap: .8rem;
}

/* Admin horizontal tabs */
.tabs-row {
  display: flex;
  flex-wrap: wrap;
  gap: .38rem;
  padding: .65rem .75rem;
  border-bottom: 1px solid #e7e5e4;
}
.tab-btn {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  white-space: nowrap;
  min-height: 36px;
  padding: .38rem .68rem;
  border-radius: 999px;
  font-size: .72rem;
  font-weight: 700;
  color: #57534e;
  background: #f5f5f4;
  cursor: pointer;
}
.tab-btn.on { background: #1c1917; color: #fff; }

/* Responsive grids tailored for smartphones */
.dept-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: .65rem;
}
@media (max-width: 339px) {
  .dept-grid { grid-template-columns: minmax(0, 1fr); }
}
@media (min-width: 640px) {
  .dept-grid { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: .85rem; }
}

.dept-card {
  background: #fff;
  border-radius: 18px;
  box-shadow: var(--shadow);
  border: 1px solid rgba(231, 229, 228, .85);
  padding: .85rem .65rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: .6rem;
  text-align: center;
}
.dept-title {
  font-weight: 800;
  font-size: .82rem;
  line-height: 1.25;
  color: #1c1917;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
@media (min-width: 640px) {
  .dept-card { padding: 1.05rem; border-radius: 22px; }
  .dept-title { font-size: .9rem; }
}

.safe-grid-2 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  gap: .85rem;
}
.safe-grid-sm {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  gap: .75rem;
}

/* Tables with sticky first column on mobile */
.table-wrap {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
table.adx {
  width: 100%;
  border-collapse: collapse;
  font-size: .76rem;
}
table.adx th {
  background: #1c1917;
  color: #fff;
  padding: .55rem .5rem;
  text-align: center;
  white-space: nowrap;
}
table.adx td {
  padding: .55rem .5rem;
  border-bottom: 1px solid #e7e5e4;
  text-align: center;
}
table.adx th.nm, table.adx td.nm {
  text-align: left;
  position: sticky;
  left: 0;
  z-index: 1;
}
table.adx th.nm { background: #1c1917; }
table.adx td.nm { background: #fff; min-width: 165px; }

/* Footer */
footer.adx-foot {
  background: #1c1917;
  color: #d6d3d1;
  font-size: .75rem;
  padding: 1.35rem 1rem calc(1.35rem + var(--safe-bottom));
}

/* Header hero */
.hero-header {
  max-width: 56rem;
  margin: 0 auto;
  padding: 1.4rem 1rem 2.2rem;
  text-align: center;
  color: #fff;
}
.hero-title {
  font-size: clamp(1.25rem, 4.5vw, 1.65rem);
  font-weight: 800;
  line-height: 1.2;
  margin: .65rem 0 .25rem;
}
@media (min-width: 640px) {
  .hero-header { padding: 2rem 1rem 2.6rem; }
}

/* Páginas personalizadas */
.cp-blocks { display: flex; flex-direction: column; gap: .75rem; }
.cp-text { font-size: .88rem; line-height: 1.6; word-wrap: break-word; }
.cp-text a { color: var(--accent); text-decoration: underline; font-weight: 600; }
.cp-video { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: #000; }
.cp-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.blk-card { border: 1px solid #e7e5e4; border-radius: 16px; padding: .85rem; background: #fff; display: grid; gap: .6rem; box-shadow: var(--shadow); }
.blk-head { display: flex; justify-content: space-between; align-items: center; gap: .4rem; flex-wrap: wrap; padding-bottom: .45rem; border-bottom: 1px dashed #e7e5e4; }
.add-blk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .45rem; }

/* ======================================================================
   ESTILO VISUAL "PADRÃO P4" (escuro, cartões e destaque dourado)
   Ativo quando o <body> tem a classe skin-p4.
   ====================================================================== */
body.skin-p4{
  --bg:var(--p4-bg,#14281d);--card:var(--p4-card,#1e3a2a);--primary:var(--p4-primary,#2f5d45);
  --gold:var(--p4-accent,#c9a227);--on-accent:#1a1a1a;--ink:#e9efe9;--mut:var(--p4-mut,#a9bbad);--line:rgba(255,255,255,.14);
  --ok:#2e9e5b;--err:#c0392b;--text:var(--ink);--text-muted:var(--mut);--surface:var(--card);
  color-scheme:dark;
  background:radial-gradient(circle at 30% 0%,var(--p4-glow,#20402d) 0%,var(--bg) 55%) fixed !important;
  background-color:var(--bg) !important;
  color:var(--ink);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
}
body.skin-p4 ::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18)}
/* faixa superior (como a faixa dourada do P4) */
body.skin-p4 .build-banner{background:#8a6d13 !important;color:#fff !important;font-weight:700;letter-spacing:.03em}
body.skin-p4 .offline-chip{background:rgba(0,0,0,.35);color:#fde68a}
/* barra do topo: marca + ações, linha dourada */
body.skin-p4 nav.top-nav{background:var(--card);border-bottom:2px solid var(--gold);box-shadow:0 6px 18px rgba(0,0,0,.35)}
body.skin-p4 .nav-inner{max-width:none;padding:0;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"brand right" "tabs tabs";gap:0}
body.skin-p4 #navBrand{grid-area:brand;display:flex;align-items:center;gap:10px;min-width:0;padding:10px 16px}
body.skin-p4 #navRight{grid-area:right;padding:10px 16px;display:flex;align-items:center;gap:6px}
body.skin-p4 #navLeft{grid-area:tabs;padding:9px 16px;border-top:1px solid var(--line);gap:7px}
#navBrand{display:none}
.nav-brand-logo{width:38px;height:38px;border-radius:10px;object-fit:contain;background:#fff;padding:2px;flex-shrink:0}
.nav-brand-ico{font-size:1.7rem;line-height:1;flex-shrink:0}
.nav-brand-txt{min-width:0}
.nav-brand-txt b{display:block;font-size:.9rem;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--ink)}
.nav-brand-txt small{display:block;font-size:.68rem;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* abas em pílula */
body.skin-p4 .nav-btn{min-height:34px;padding:7px 12px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--mut);font-size:.76rem;font-weight:600}
body.skin-p4 .nav-btn.on{background:var(--gold);color:#1a1a1a;border-color:var(--gold)}
body.skin-p4 .nav-btn.gold{background:var(--primary);color:#fff;border-color:var(--primary)}
body.skin-p4 .nav-btn.install{background:rgba(46,158,91,.2);color:#6fe0a0;border-color:rgba(46,158,91,.55)}
body.skin-p4 .profile-btn{background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:8px;color:var(--ink);font-weight:600}
body.skin-p4 .sim-bar{background:rgba(201,162,39,.12);color:#e6c95a;border-top:1px solid var(--line)}
/* faixa de saudação (banner do P4) */
.p4-banner{background:linear-gradient(90deg,rgba(201,162,39,.16),transparent);border-bottom:1px solid var(--line)}
.p4-banner-in{max-width:56rem;margin:0 auto;padding:14px 16px;display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;justify-content:space-between}
.p4-banner strong{font-size:.98rem;color:var(--ink)}
.p4-banner p{margin:3px 0 0;font-size:.76rem;color:var(--mut)}
.p4-chips{display:flex;flex-wrap:wrap;gap:6px}
.p4-chip{display:inline-flex;align-items:center;gap:.35rem;border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--mut);border-radius:999px;padding:.3rem .7rem;font-size:.7rem;font-weight:600;cursor:default}
