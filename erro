/* ---------- otimizar fotos já salvas ---------- */
function collectStoredImages(){
  var list=[];
  function add(obj,prop,profile){if(obj&&typeof obj[prop]==="string"&&obj[prop].indexOf("data:image/")===0) list.push({o:obj,k:prop,p:profile});}
  add(state.church,"logoUrl","logo");
  var pl=state.church.pageLogos||{};Object.keys(pl).forEach(function(k){add(pl,k,"logo");});
  state.users.forEach(function(u){add(u,"photo","avatar");});
  state.departments.forEach(function(dp){add(dp,"photo","avatar");(dp.team||[]).forEach(function(m){add(m,"photo","avatar");});});
  state.directorate.forEach(function(d){add(d,"photo","avatar");});
  (state.customPages||[]).forEach(function(p){add(p,"logo","logo");(p.blocks||[]).forEach(function(b){if(b.type==="image") add(b,"url","banner");});});
  return list;
}
A.optimizeImages=function(el){
  var list=collectStoredImages();
  if(!list.length){toast("Não há fotos salvas no aparelho para otimizar.");return;}
  var before=0,after=0,i=0;
  list.forEach(function(x){before+=dataBytes(x.o[x.k]);});
  if(el){el.disabled=true;el.style.opacity=".6";}
  function next(){
    if(i>=list.length){
      list.forEach(function(x){after+=dataBytes(x.o[x.k]);});
      save();render();
      toast("Fotos otimizadas: "+fmtKB(before)+" → "+fmtKB(after)+" ("+list.length+" imagens)","success");
      return;
    }
    var x=list[i++];
    if(el) el.textContent="Otimizando "+i+" de "+list.length+"...";
    compressDataUrl(x.o[x.k],x.p,function(out){x.o[x.k]=out;setTimeout(next,0);});
  }
  next();
};

