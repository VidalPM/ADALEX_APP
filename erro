    '<button class="btn-main" id="gp_go" style="width:100%">Confirmar</button></div>',function(d){
      var inp=d.querySelector("#gp_pass"),go=d.querySelector("#gp_go");
      function fire(){var pw=inp.value;if(!normalizePass(pw)){toast("Digite sua senha.","error");return;}cb(pw,d,go);}
