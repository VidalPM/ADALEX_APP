function gasUrl(){return (GAS&&GAS.url)||"";}
function gasRun(fn,args,ok,fail){
  if(!IS_GAS){if(fail) fail({message:"Disponível apenas no Google Apps Script."});return;}
  var r=google.script.run
    .withSuccessHandler(function(x){if(ok) ok(x);})
    .withFailureHandler(function(e){if(fail) fail(e); else toast("Erro no servidor: "+((e&&e.message)||e),"error");});
  r[fn].apply(r,args||[]);
}
function askPassword(title,text,cb){
