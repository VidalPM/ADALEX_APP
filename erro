/* ---------- equipe automática dos departamentos ---------- */
var curPage=null;
var TEAM_GENERIC={"membro":1,"membros":1,"departamento":1,"igreja":1,"visitante":1,"geral":1};
function resolvePageDept(p){
  if(!p) return null;
  if(p.departmentId){var d=findDept(p.departmentId);if(d) return d;}
  var pt=plain(p.title);
  if(pt.length<4) return null;
  return state.departments.find(function(d){
    var dn=plain(d.name);
    return dn===pt||(pt.length>=5&&dn.indexOf(pt)>=0)||(dn.length>=5&&pt.indexOf(dn)>=0);
  })||null;
}
function userMatchesDept(u,dep){
  var pd=plain(u.department);
  if(!pd||TEAM_GENERIC[pd]) return false;
  var dn=plain(dep.name);
  return pd===dn||(pd.length>=4&&dn.indexOf(pd)>=0);
}
function userByName(n){var k=plain(n);return k?state.users.find(function(u){return plain(u.name)===k;}):null;}
/* junta dirigente + equipe cadastrada + pessoas cujo cadastro indica o departamento */
function isLeaderRole(r){return /dirigente|l[ií]der|coordenador|presidente|superintendente|diretor|respons[aá]vel/i.test(String(r||""));}
/* A equipe vem exclusivamente de Diretoria & Equipes → Equipes dos departamentos.
   Quem tiver função de Dirigente/Líder/Coordenador... aparece primeiro e em destaque. */
function deptTeamMembers(dep){
  var out=[],seen={};
  (dep&&dep.team||[]).forEach(function(m){
    var k=plain(m.name);if(!k||seen[k]) return;seen[k]=1;
    out.push({name:m.name,role:m.role||"Integrante",photo:m.photo||"",phone:m.phone||"",leader:isLeaderRole(m.role)});
  });
  return out.filter(function(m){return m.leader;}).concat(out.filter(function(m){return !m.leader;}));
}
/* ---------- equipe automática das páginas Secretaria / Tesouraria / EBD ---------- */
var AREA_TEAM_RULES={
  secretaria:{dir:["sec_1","sec_2","sec_adj"],words:["secret"],deptWords:["secretaria"]},
  tesouraria:{dir:["cont_1","cont_2"],words:["tesour","contab","financ"],deptWords:["tesouraria","financeiro","contab"]},
  ebd:{dir:["ensino_1","ensino_2"],words:["ebd","escola biblica","ensino","professor"],deptWords:["escola biblica","ebd"]}
};
function hasWord(txt,words){var p=plain(txt);return words.some(function(w){return p.indexOf(w)>=0;});}
function areaDept(pg,sec){
  if(sec&&sec.deptId&&sec.deptId!=="auto"){var d=findDept(sec.deptId);if(d) return d;}
  var R=AREA_TEAM_RULES[pg];if(!R) return null;
  return state.departments.find(function(d){return hasWord(d.name,R.deptWords);})||null;
}
function areaTeamMembers(pg,sec){
  sec=sec||{};
  var R=AREA_TEAM_RULES[pg];if(!R) return [];
  var out=[],seen={};
  function add(m){var k=plain(m.name);if(!k||seen[k]) return;seen[k]=1;out.push(m);}
  /* 1. Diretoria da igreja (Diretoria & Equipes → cargos da diretoria ligados à área) */
  if(sec.srcDir!==false){
    state.directorate.forEach(function(d){
      if(!d.name||d.visible===false) return;
      if(R.dir.indexOf(d.id)>=0||hasWord(d.role,R.words)) add({name:d.name,role:d.role,photo:d.photo||"",phone:d.phone||"",leader:true});
    });
  }
  /* 2. Equipe do departamento ligado (Diretoria & Equipes → Equipes dos departamentos) */
  if(sec.srcDept!==false){
    var dep=areaDept(pg,sec);
    if(dep) deptTeamMembers(dep).forEach(add);
  }
  return out;
}

