  if(!lbl){toast("Informe o nome do cargo.","error");return;}
  var dup=allRoles().find(function(x){return x.id!==id&&plain(x.label)===plain(lbl);});
  if(dup){toast("Já existe um cargo com este nome.","error");return;}
  r.label=lbl;r.cls=v("rl_c_"+id)||r.cls;
  if(!r.system){var l=parseInt(v("rl_l_"+id),10);if(!isNaN(l)) r.level=Math.min(Math.max(l,0),4);}
  save();render();toast('Cargo "'+lbl+'" salvo',"success");
};
A.roleDelete=function(el){
  var id=el.getAttribute("data-id"),r=allRoles().find(function(x){return x.id===id;});
  if(!r||PROTECTED_ROLES[id]) return;
  var n=roleCount(id);
  openConfirm('Apagar o cargo "'+r.label+'"?'+(n?" "+n+" pessoa(s) com este cargo passarão a ser Membro.":""),function(){
    state.roles=allRoles().filter(function(x){return x.id!==id;});
    state.users.forEach(function(u){if(u.role===id) u.role="membro";});
