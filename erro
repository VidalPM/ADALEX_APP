  if(digits.length<9) return failLogin("Digite o CPF completo (11 números).");
  var usr=state.users.find(function(u){return cpfMatches(u.cpf,digits);});
  if(!usr) return failLogin("CPF não encontrado no cadastro de membros. Procure a secretaria da igreja.");
