    (state.customPages||[]).forEach(function(p){if(Array.isArray(p.visibleTo)) p.visibleTo=p.visibleTo.filter(function(x){return x!==id;});});
    state.departments.forEach(function(d){if(Array.isArray(d.visibleTo)) d.visibleTo=d.visibleTo.filter(function(x){return x!==id;});});
