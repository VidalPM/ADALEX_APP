/* ======================================================================
   PROTEÇÃO DE DADOS (CPF e senhas)
   No arquivo publicado, CPFs e senhas ficam guardados como "hash"
   (código irreversível). O login continua funcionando porque o app
   calcula o hash do que a pessoa digita e compara.
   ====================================================================== */
function sha256hex(str){
