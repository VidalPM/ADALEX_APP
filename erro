function blockLinkAttrs(b){
  if(b.action==="page"){
    var pg=b.value||"home";
    return 'href="#" data-act="go" data-page="'+esc(pg)+'"';
  }
  var href=blockHref(b);
  var ext=(b.action==="url"||b.action==="whatsapp");
  return 'href="'+esc(href)+'"'+(ext?' target="_blank" rel="noopener noreferrer"':"");
}
function richText(s){
  var h=esc(s||"");
  h=h.replace(/\*\*(.+?)\*\*/g,"<b>$1</b>");
  h=h.replace(/(https?:\/\/[^\s<]+)/g,function(u){return '<a href="'+u+'" target="_blank" rel="noopener noreferrer">'+u+"</a>";});
  return h.replace(/\n/g,"<br>");
}
