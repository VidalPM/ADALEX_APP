  var safeJson=JSON.stringify(publishableState()).replace(/<\/script/gi,"<\\/script").replace(/\x3C!--/g,"\\u003c!--");
  var finished=false;
  function finish(src){
    if(finished) return;finished=true;
    var htmlStr=src.replace(/\/\*__CUSTOM_STATE_START__\*\/[\s\S]*?\/\*__CUSTOM_STATE_END__\*\//,function(){return "/*__CUSTOM_STATE_START__*/var EMBEDDED_STATE="+safeJson+";/*__CUSTOM_STATE_END__*/";});
    downloadHtml(htmlStr);
    toast("index.html personalizado baixado! CPFs e senhas foram protegidos.","success");
    setTimeout(render,600);
  }
  if(/^https?:$/.test(location.protocol)&&window.fetch){
    fetch(location.href.split("#")[0].split("?")[0],{cache:"no-store",headers:{"Accept":"text/html"}})
      .then(function(r){return r.ok?r.text():"";})
      .then(function(t){finish(t&&t.indexOf("__CUSTOM_STATE_START__")>=0&&t.indexOf("function publishableState")>=0?t:cleanCloneForExport());})
      .catch(function(){finish(cleanCloneForExport());});
    setTimeout(function(){finish(cleanCloneForExport());},8000);
  }else finish(cleanCloneForExport());
};

