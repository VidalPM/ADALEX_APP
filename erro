          toast("Publicado! Todos já podem ver as alterações.","success");
        }else if(r&&r.conflito){
          openConfirm("Outra pessoa publicou alterações em "+(fmtVersion(r.publishedAt)||"outro momento")+", depois que você abriu o app. Publicar agora vai substituir o que ela publicou. Deseja continuar?",function(){send(true);});
        }else toast((r&&r.msg)||"Não foi possível publicar.","error");
      },function(e){busy(go,false,"Confirmar");toast("Erro ao publicar: "+((e&&e.message)||e),"error");});
    }
    send(false);
  });
}
function gasSendSubmission(sub){
  if(!IS_GAS||!sub) return;
  gasRun("registrar",[JSON.stringify(sub)],function(){},function(){});
}
A.gasLoadRecords=function(){
  askPassword("☁️ Registros enviados pelo app","Carrega os pedidos de oração e as decisões que os visitantes e membros enviaram pelo aplicativo (ficam guardados num arquivo privado do Google Drive).",function(pw,d,go){
    busy(go,true,"Carregando...");
    gasRun("listarRegistros",[pw],function(r){
      busy(go,false,"Confirmar");
      if(!r||!r.ok){toast((r&&r.msg)||"Não foi possível carregar.","error");return;}
      var have={};state.submissions.forEach(function(s){have[s.id]=1;});
      var n=0;(r.registros||[]).forEach(function(s){if(!have[s.id]){state.submissions.push(s);n++;}});
      state.submissions.sort(function(a,b){return String(b.recebidoEm||b.id).localeCompare(String(a.recebidoEm||a.id));});
      save();d._allowClose=true;d.close();render();
      toast(n?n+" registro(s) novo(s) carregado(s).":"Nenhum registro novo.","success");
    },function(e){busy(go,false,"Confirmar");toast("Erro: "+((e&&e.message)||e),"error");});
  });
};
A.gasClearRecords=function(){
  openConfirm("Apagar TODOS os registros guardados no Google Drive? Os que já foram carregados neste aparelho continuam aqui.",function(){
    askPassword("🗑️ Apagar registros do servidor","Confirme com a sua senha.",function(pw,d,go){
      busy(go,true,"Apagando...");
      gasRun("limparRegistros",[pw],function(r){
        busy(go,false,"Confirmar");
        if(r&&r.ok){d._allowClose=true;d.close();toast("Registros do servidor apagados.","success");}
        else toast((r&&r.msg)||"Não foi possível apagar.","error");
      });
    });
  });
};
function gasCheckUpdate(force){
  if(upd.checking) return;
  if(!force&&Date.now()-upd.lastCheck<60000) return;
  upd.checking=true;upd.lastCheck=Date.now();
  gasRun("getMeta",[],function(m){
    upd.checking=false;
    if(!m||!m.publishedAt) return;
    var ver=(m.appVersion||APP_VERSION)+"|"+m.publishedAt;
    if(ver===LOADED_VERSION) return;
    var info=updInfo({updateInfo:m.updateInfo});
    if(!info.enabled||upd.shownFor===ver) return;
    try{if(sessionStorage.getItem("adalex_upd_later")===ver&&!info.force) return;}catch(e){}
    upd.shownFor=ver;
    showUpdatePopup(info,ver,false);
  },function(){upd.checking=false;});
}
/* links externos abrem em nova aba (dentro do Apps Script o app roda num quadro) */
if(IS_GAS){
  document.addEventListener("click",function(e){
    var a=e.target&&e.target.closest?e.target.closest("a[href]"):null;
    if(!a||a.getAttribute("target")||a.hasAttribute("data-act")||a.hasAttribute("data-nav")) return;
    var h=a.getAttribute("href")||"";
    if(!h||h.charAt(0)==="#") return;
    a.setAttribute("target","_blank");a.setAttribute("rel","noopener noreferrer");
  },true);
}

/* generic click & input listeners */
document.addEventListener("click",function(e){
  var nav=e.target.closest("[data-nav]");
  if(nav){e.preventDefault();ui.page=nav.getAttribute("data-nav");render();window.scrollTo(0,0);return;}
  var el=e.target.closest("[data-act]");
  if(!el) return;
  var act=el.getAttribute("data-act");
  if(typeof A[act]!=="function") return;
  if(el.tagName==="A") e.preventDefault();
  try{A[act](el,e);}catch(err){toast("Ação indisponível: "+err.message,"error");}
});

document.addEventListener("input",function(e){
  if(e.target&&e.target.id==="gate_cpf"){
    var fm=formatCpf(e.target.value);
    if(fm!==e.target.value) e.target.value=fm;
    return;
  }
  if(e.target&&e.target.id==="us_search"){
    ui.userSearch=e.target.value;
    var pos=e.target.selectionStart;
    render();
    var box=document.getElementById("us_search");
    if(box){box.focus();try{box.setSelectionRange(pos,pos);}catch(err){}}
  }
});

document.addEventListener("change",function(e){
  if(e.target&&e.target.id==="us_func_filter"){
    ui.funcFilter=e.target.value;
    render();
  }
});

window.addEventListener("keydown",function(e){
  if(e.key==="Escape") closeAllDialogs();
  if(e.key==="Enter"&&e.target&&e.target.id==="nf_name"){
    e.preventDefault();
    A.createInlineFunc();
  }
  if(e.key==="Enter"&&e.target&&e.target.id==="gate_cpf"){
    e.preventDefault();
    A.gateMemberEnter();
  }
  if(e.key==="Enter"&&e.target&&e.target.id==="gate_pass"){
    e.preventDefault();
    A.gateStaffEnter();
  }
  if(e.key==="Enter"&&e.target&&e.target.id==="gate_v_name"){
    e.preventDefault();
    A.gateVisitorEnter();
  }
});

