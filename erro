}
/* Quais cargos podem entrar em cada aba de acesso */
function modeAllows(mode,role){
  var lvl=roleLevel(role);
  if(role==="admin_geral"||lvl>=4) return true;
  if(mode==="admin") return false;
  if(mode==="lideranca") return lvl>=2;
  if(role==="diretoria") return true;
  return role===mode;
}
/* Secretaria, Tesouraria, EBD, Liderança/Diretoria e Administrador: senha pessoal pré-cadastrada */
function loginByPassword(raw,mode){
  var pass=normalizePass(raw);
  var lbl=gateModeLabel(mode);
  if(!pass) return failLogin("Digite sua senha pessoal.");
  if(mode==="admin"){
    if(passMatches(state.church.masterAdminPin,pass)){
      var adm=findUser("u1")||{id:"u1",name:"Administrador",role:"admin_geral",photo:"",memberCode:""};
      return previewLogin(adm,"admin_geral",true,"password");
    }
  }
  var usr=state.users.find(function(u){return passMatches(u.accessPassword,pass);});
  if(!usr) return failLogin("Senha pessoal não encontrada. Confira ou peça ao administrador para cadastrar sua senha.");
  if(!modeAllows(mode,usr.role)) return failLogin("Seu cadastro ("+roleObj(usr.role).label+") não tem acesso de "+lbl+". Escolha a aba do seu acesso.");
  var target=(mode==="lideranca"||mode==="admin")?usr.role:mode;
  return previewLogin(usr,target,mode==="admin","password");
}
function doLogin(raw,d){
  if(d) d.close();
  var mode=ui.gateMode||"member";
  if(mode==="visitor") mode="member";
  return mode==="member"?loginByCpf(raw):loginByPassword(raw,mode);
}

/* ---------- import of members ---------- */
function parseLine(line){
  var t=line.trim();if(!t) return null;
  if(/^(nome|membro|c[oó]digo|matr[ií]cula)\b/i.test(t)&&/(c[oó]digo|matr[ií]cula)/i.test(t)&&!/\d/.test(t)) return {skip:true};
  var parts=t.split(/\s*[|;:\t,]\s*|\s+-\s+/).map(function(x){return x.trim();}).filter(Boolean);
  var name="",code="";
  if(parts.length===1){
    if(/^\d+$/.test(parts[0])) code=parts[0]; else name=parts[0];
  } else {
    var numIdx=-1;parts.forEach(function(p,i){if(numIdx<0&&/^\d{2,}$/.test(p)) numIdx=i;});
    if(numIdx>=0){code=parts[numIdx];name=parts.filter(function(_,i){return i!==numIdx;}).join(" ");}
    else name=parts.join(" ");
  }
  return {name:name.trim(),code:code.trim()};
}
function classifyImport(text){
  var lines=String(text||"").split(/\r?\n/);
  var out=[],seenCodes={},seenNames={};
  lines.forEach(function(l){
    var p=parseLine(l);if(!p||p.skip) return;
    var item={name:p.name,code:p.code,status:""};
    if(!item.name){item.status="Sem nome";}
    else if(item.code){
      var byCode=state.users.find(function(u){return u.memberCode&&u.memberCode===item.code;});
      if(seenCodes[item.code]) item.status="Duplicado na lista";
      else if(byCode) item.status="Já cadastrado com este código";
      else item.status="Novo";
      seenCodes[item.code]=true;
    } else {
      var byName=state.users.find(function(u){return plain(u.name)===plain(item.name);});
      if(seenNames[plain(item.name)]) item.status="Duplicado na lista";
      else if(byName) item.status="Nome já existe sem código";
      else item.status="Sem código";
      seenNames[plain(item.name)]=true;
    }
    out.push(item);
  });
  return out;
}
